{
  "name": "la-pocha-online",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"tsx watch server/index.ts\" \"vite --host 0.0.0.0\"",
    "build": "tsc --noEmit && vite build",
    "build:pocha": "tsc --noEmit && vite build --base=/pocha/",
    "start": "tsx server/index.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "test": "vitest run",
    "simulate": "tsx scripts/simulate.ts",
    "smoke": "tsx scripts/smoke.ts",
    "smoke:rooms": "tsx scripts/rooms-smoke.ts",
    "smoke:production": "tsx scripts/production-smoke.ts",
    "smoke:restart": "tsx scripts/restart-smoke.ts",
    "smoke:pacing": "tsx scripts/pacing-smoke.ts",
    "smoke:auto-restart": "tsx scripts/auto-restart-smoke.ts",
    "smoke:manual-finish": "tsx scripts/manual-finish-smoke.ts",
    "smoke:advanced": "tsx scripts/advanced-smoke.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "framer-motion": "^11.15.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.1.7",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.6.1",
    "concurrently": "^9.1.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
